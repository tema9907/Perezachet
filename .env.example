# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env

# Google Gemini API — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Учётные данные is.ku.edu.kz (модуль формального перезачёта, NTLM-аутентификация)
# Логин обычно без домена, напр. ansemejnikov
KU_USERNAME=your_ku_login
KU_PASSWORD=your_ku_password
# Факультет по умолчанию (58 = ФИЦТ)
KU_FACULTY=58

# Ngrok — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-domain.ngrok-free.app
